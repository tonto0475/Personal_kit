# 비밀값 — 값은 유저가 직접 채움. 커밋 금지
.env

# 로그 두 종 — 실행할 때마다 쌓임
logs/app.log
logs/debug.log

# 파이썬 실행 부산물 — 테스트를 돌릴 때마다 생김(2026-10-29 후보에서 등록으로)
__pycache__/
*.pyc
.pytest_cache/

# ===== 미리 등록 후보 — 필요해지면 줄 앞 # 를 지운다 =====
# 패턴 뒤 같은 줄에 주석을 달지 않는다(줄 전체가 패턴이 되어 조용히 무효)
#
# 가상환경
# .venv/
#
# 입력 원본 데이터(개인정보 · 대용량 가능)
# data/*
# !data/.gitkeep
#
# 버릴 임시 테스트
# tests/tmp/*
# !tests/tmp/.gitkeep
#
# 환경마다 다른 로컬 설정
# config/local.yaml
#
# out/ 은 결과물(제출물)이라 등록하지 않는다
