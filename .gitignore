# 비밀값 — 값은 유저가 직접 채움. 커밋 금지
.env

# 로그 두 종 — 실행할 때마다 쌓임
logs/app.log
logs/debug.log

# 파이썬 실행 부산물 — 테스트를 돌릴 때마다 생김(2026-10-29 후보에서 등록으로)
__pycache__/
*.pyc
.pytest_cache/

# ready-start 가 쓰는 세션 띄우는 명령 · 준비 상태(2026-11-04) — 이 기계 경로가 들어가고 언제든 다시 만든다
ReadyStart.md

# devview 코덱스 허브 — 세션 등록 · 상태 줄 · 누적 · 마법봉 요청(작업 폴더 안 · Codex 샌드박스가 쓸 수 있는 곳 · 2026-11-02)
.codex-hub/

# ===== 미리 등록 후보 — 필요해지면 줄 앞 # 를 지운다 =====
# 패턴 뒤 같은 줄에 주석을 달지 않는다(줄 전체가 패턴이 되어 조용히 무효)
#
# 가상환경
# .venv/
#
# 입력 원본 데이터(개인정보 · 대용량 가능)
# data/*
# !data/.gitkeep
#
# 버릴 임시 테스트
# tests/tmp/*
# !tests/tmp/.gitkeep
#
# 환경마다 다른 로컬 설정
# config/local.yaml
#
# out/ 은 결과물(제출물)이라 등록하지 않는다

# bookkit — 과제 파악 책 키트(2026-11-03) · 패턴 뒤 같은 줄에 주석을 달지 않는다
# 사전 체험 결과 — 그 환경의 기록이라 저장소에 안 넣는다
precheck.md
# 예시 책(book_example — 09 · 10 최종본 · 펼침 PNG)은 메인이 벤치마크하도록 올린다(2026-11-03 유저 결정 · 11-04 뺀 10 을 11-05 다시 넣음)
# 만든 책에는 대회 과제 내용(숫자 · 원본 줄 · 자료 사본)이 그대로 들어간다
bookkit/books/
# 빌드 출력(html) — 언제든 다시 만든다
bookkit/**/dist/

# skeleton — 뼈대 계획표 출력(과제 내용이 들어감 · 언제든 plan.py 로 다시 만든다)
skeleton/out/

# 지급 자료 복사본(편집 · 표시용 — 원본은 과제 폴더에 그대로) · 과제 내용이라 올리지 않는다
task_copy/
